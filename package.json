    "test:distributions": "node --test system/distribution/distribution.test.mjs",
    "doctor": "node system/compat/doctor.mjs",
    "or": "node scripts/integrations/openrouter-runner.mjs",
    "or:scan": "node scripts/integrations/openrouter-runner.mjs scan",
    "or:pipeline": "node scripts/integrations/openrouter-runner.mjs pipeline",
    "or:eval": "node scripts/integrations/openrouter-runner.mjs evaluate",
    "or:apply": "node scripts/integrations/openrouter-runner.mjs apply",
    "verify": "node scripts/system/verify-pipeline.mjs",
    "cn:doctor": "node scripts/tracker/market-cn.mjs doctor",
