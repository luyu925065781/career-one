    "tracker": "node scripts/tracker/tracker.mjs",
    "find": "node scripts/tracker/find.mjs",
    "patterns": "node scripts/analysis/analyze-patterns.mjs",
    "add": "node scripts/application/add-entry.mjs",
    "reposts": "node scripts/analysis/detect-reposts.mjs",
    "invite-match": "node scripts/tracker/invite-match.mjs",
    "gemini:eval": "node scripts/integrations/gemini-eval.mjs",
    "ollama:eval": "node scripts/integrations/ollama-eval.mjs",
    "openai:eval": "node scripts/integrations/openai-eval.mjs",
    "star": "node scripts/application/match-star.mjs",
    "archive": "node scripts/application/archive-posting.mjs",
    "prepare:application": "node scripts/application/prepare-application.mjs",
    "build:dashboard": "node scripts/system/build-dashboard.mjs",
