    "pdf": "node scripts/generate/generate-pdf.mjs",
    "cover-letter": "node scripts/generate/generate-cover-letter.mjs --payload",
    "sync-check": "node scripts/system/cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node tests/system/updater-migration.test.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "release:status": "node scripts/system/release.mjs status",
    "release:verify": "node scripts/system/release.mjs verify",
    "release:prepare": "node scripts/system/release.mjs prepare",
